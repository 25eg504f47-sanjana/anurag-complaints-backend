# Set these as environment variables on Railway (never commit real values).
# Aiven MySQL: copy host, port, user, password from the service "Connection information" tab.
DB_URL=jdbc:mysql://<aiven-host>:<aiven-port>/defaultdb?sslMode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=<aiven-password>

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=<long-random-string>

# Your deployed frontend URL(s), comma separated, no trailing slash
CORS_ORIGINS=https://your-app.vercel.app

# First admin account, created on first startup
ADMIN_EMAIL=admin@anurag.edu.in
ADMIN_PASSWORD=<strong-password>
